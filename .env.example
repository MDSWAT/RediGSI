NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server only: add this to the hosting environment as well.
SUPABASE_SECRET_KEY=your-server-secret-key

# Optional: existing Supabase Auth account for one-time administrator bootstrap.
REDI_ADMIN_EMAIL=admin@example.org

# Optional server-only geocoder: organization-approved Nominatim-compatible provider.
# No requests are made until configured and explicitly requested by an editor.
# The shared public nominatim.openstreetmap.org endpoint is not supported.
REDI_GEOCODER_URL=
REDI_GEOCODER_USER_AGENT=
REDI_GEOCODER_API_KEY=

# Optional: CARTO basemap key (free at https://carto.com/basemaps/apikey). When set, CARTO Voyager
# becomes the default road map; otherwise the Esri light map is used.
NEXT_PUBLIC_CARTO_BASEMAP_KEY=
