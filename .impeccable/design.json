      "refersTo": "button-danger",
      "description": "Implemented action variant.",
      "html": "<button class=\"ds-button-danger\">Șterge</button>",
      "css": ".ds-button-danger{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:38px;padding:8px 12px;border:1px solid var(--border,#345347);background:var(--panel,#224134);color:var(--text,#fffeff);border-radius:0;cursor:pointer;font:550 14px/1.4 var(--font-host-grotesk,'Host Grotesk'),sans-serif;transition:background-color 160ms,border-color 160ms,color 160ms;color:var(--danger,#f4d9db);}.ds-button-danger:hover:not(:disabled){background:var(--hover,#2d5141);border-color:#a0b6a6;}.ds-button-danger:focus-visible{outline:2px solid #fffeff;outline-offset:3px;}.ds-button-danger:disabled{opacity:.55;cursor:default;}@media(prefers-reduced-motion:reduce){.ds-button-danger{transition:none;}}"
    },
    {
      "name": "Community Search",
      "kind": "input",
      "refersTo": "input",
      "description": "Compact record search with inset stroke icon.",
      "html": "<div class=\"ds-search-group\"><label for=\"ds-community-search\">Caută în registru</label><div class=\"ds-search\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m21 21-5-5M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z\"/></svg><input id=\"ds-community-search\" placeholder=\"Nume, localitate sau SIRUTA\"></div></div>",
      "css": ".ds-search-group{display:flex;flex-direction:column;gap:6px;}.ds-search-group>label{font:12px/1.5 var(--font-host-grotesk,'Host Grotesk'),sans-serif;color:var(--muted,#e0e0df);}.ds-search{position:relative;display:flex;align-items:center;color:var(--muted,#e0e0df);}.ds-search>svg{position:absolute;left:13px;pointer-events:none;}.ds-search input{width:100%;min-width:0;height:42px;padding:9px 11px 9px 40px;border:1px solid var(--control-border,#879e90);border-radius:0;background:var(--panel,#224134);color:var(--text,#fffeff);font:12px var(--font-host-grotesk,'Host Grotesk'),sans-serif;caret-color:var(--primary,#fde68a);}.ds-search input::placeholder{color:#d3dfd5;opacity:1;}.ds-search input:focus-visible{outline:2px solid #fffeff;outline-offset:3px;}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "refersTo": "nav-active",
      "description": "Persistent left dataset rail with yellow active labels.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Secțiuni\"><button class=\"ds-route\" aria-current=\"page\"><svg width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3V6Zm6-3v15m6-12v15\"/></svg><span>Comunități</span></button><button class=\"ds-route\"><svg width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3V6Zm6-3v15m6-12v15\"/></svg><span>Date</span></button></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;align-items:center;gap:6px;width:64px;background:var(--bg,#1b3a2e);}.ds-route{display:inline-flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;min-height:60px;width:100%;padding:9px 2px;border:0;background:transparent;color:var(--muted,#e0e0df);border-radius:0;font:500 9px/1.4 var(--font-host-grotesk,'Host Grotesk'),sans-serif;cursor:pointer;transition:background-color 160ms,color 160ms;}.ds-route:hover{color:white;background:#224134;}.ds-route[aria-current=page],.ds-route[aria-current=page]:hover{background:var(--panel,#224134);color:var(--primary,#fde68a);}.ds-route:focus-visible{outline:2px solid #fffeff;outline-offset:3px;}@media(max-width:1100px){.ds-route{font-size:8px;}}@media(max-width:760px){.ds-nav{width:48px;}.ds-route{min-height:52px;padding:8px 0;font-size:10px;gap:5px;}.ds-route svg{width:20px;height:20px;}}@media(max-height:600px){.ds-nav{gap:3px;}.ds-route{min-height:44px;padding-block:5px;gap:3px;}.ds-route svg{width:18px;height:18px;}}@media(prefers-reduced-motion:reduce){.ds-route{transition:none;}}"
    },
