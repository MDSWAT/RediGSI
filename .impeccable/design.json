      "html": "<button class=\"ds-btn-primary\">Importă date</button>",
      "css": ".ds-btn-primary{font-family:var(--font-host-grotesk),sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:38px;padding:8px 12px;border:1px solid var(--control-border,#d5dce2);border-radius:var(--radius,8px);font-size:14px;font-weight:550;line-height:1.4;cursor:pointer;transition:background-color 160ms,border-color 160ms,color 160ms;background:var(--primary,#107c70);color:var(--primary-text,#fff);border-color:var(--primary,#107c70);}.ds-btn-primary:hover:not(:disabled){background:var(--primary-hover,#096559);border-color:var(--primary-hover,#096559);}.ds-btn-primary:focus-visible{outline:2px solid var(--primary,#107c70);outline-offset:3px;}.ds-btn-primary:disabled{opacity:.55;cursor:default;}@media(prefers-reduced-motion:reduce){.ds-btn-primary{transition:none;}}"
