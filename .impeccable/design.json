      "refersTo": "input",
      "description": "Labeled operational field.",
      "html": "<label class=\"ds-field\">Localitate<input placeholder=\"Caută o localitate\" /></label>",
      "css": ".ds-field{font-family:var(--font-host-grotesk),sans-serif;display:flex;flex-direction:column;gap:6px;font-size:12px;color:var(--muted,#64717d);}.ds-field input{font-family:var(--font-host-grotesk),sans-serif;padding:9px 11px;border:1px solid var(--control-border,#d5dce2);border-radius:var(--radius,8px);background:var(--panel,#fff);color:var(--text,#202b33);font-size:13px;}.ds-field input:focus-visible{outline:2px solid var(--primary,#107c70);outline-offset:3px;}"
    },
    {
      "name": "Active Module Navigation",
      "kind": "nav",
      "refersTo": "nav-active",
      "description": "Permission-aware module destination; public sees Map and Analytics.",
      "html": "<button class=\"ds-nav\" aria-current=\"page\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3V6Zm6-3v15m6-12v15\"/></svg>Hartă<span></span></button>",
      "css": ".ds-nav{font-family:var(--font-host-grotesk),sans-serif;display:flex;align-items:center;gap:11px;min-height:42px;min-width:176px;padding:10px 12px;border:0;border-radius:8px;background:#e5f0ec;color:#11695d;font-size:13px;font-weight:500;cursor:pointer;}.ds-nav span{width:5px;height:5px;border-radius:50%;background:currentColor;margin-left:auto;}.ds-nav:hover{background:#e5f0ec;color:#11695d;}.ds-nav:focus-visible{outline:2px solid var(--primary,#107c70);outline-offset:3px;}"
