  "narrative": {
    "northStar": "Fieldwork Atlas",
    "overview": "Restrained mineral whites, forest navigation and petrol-green actions frame a readable daytime workspace. System typography and precise stroke icons give Romanian records and geographic evidence priority.\n\nThe fieldwork atlas direction uses calm tonal surfaces for dense work. Borders separate records; shadows lift tools over the map and isolate dialogs.",
    "keyCharacteristics": [
      "Mineral white surfaces with a forest navigation spine.",
      "Compact, readable system typography and tabular counts.",
      "Petrol actions and stable geographic status colors.",
      "Precise stroke icons and restrained depth."
    ],
    "rules": [
      {
        "name": "The Status Continuity Rule",
        "body": "Keep community status colors consistent across badges, legends and map geometry.",
        "section": "colors"
      },
      {
        "name": "The Working Surface Rule",
        "body": "Use borders and tonal layering for records; reserve lift for controls above the map and modal content.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use labeled status colors consistently in lists, legends and map geometry.",
      "Do keep keyboard focus visible on controls and record selection.",
      "Do use tabular numerals for counts, statistics and tables.",
      "Do preserve Romanian diacritics and readable compact labels."
    ],
    "donts": [
      "Don't turn ordinary record sections into floating shadow cards.",
      "Don't use the proposed-community amber as a general action accent.",
      "Don't add decorative raster imagery to the working map interface.",
      "Don't animate controls when reduced motion is requested."
    ]
  }
}
