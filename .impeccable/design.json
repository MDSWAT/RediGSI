  "narrative": {
    "northStar": "Forest Field Guide",
    "overview": "Forest-green ground and surfaces frame a compact working atlas, with warm yellow marking actions, links and the active dataset. Host Grotesk gives headings and operational controls a precise voice; EB Garamond supports explanatory text and source material.\n\nThe interface owns the viewport: a persistent left menu, compact topbar and independently scrolling task tools leave the map or report as the main surface. Square forms and restrained depth preserve the field-guide identity while semantic dataset colors retain their established meanings.",
    "keyCharacteristics": [
      "Forest-green layers and warm-yellow action emphasis.",
      "Host Grotesk display and UI paired with EB Garamond prose.",
      "Square controls and a dominant working map.",
      "Labeled status colors, scope dashes and visible source provenance."
    ],
    "rules": [
      {
        "name": "The Yellow Emphasis Rule",
        "body": "Use warm yellow for primary actions, links, identity and active navigation; keep reading surfaces green.",
        "section": "colors"
      },
      {
        "name": "The Geographic Continuity Rule",
        "body": "Preserve map dataset colors independently of interface action colors.",
        "section": "colors"
      },
      {
        "name": "The Working Surface Rule",
        "body": "Separate ordinary records with borders and tonal changes; reserve shadows for floating tools, tool drawers and dialogs.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use Host Grotesk for display, controls and data; use EB Garamond for reading text.",
      "Do pair yellow primary actions with their black label color.",
      "Do keep controls square, keyboard focus visible and numeric columns tabular.",
      "Do preserve labeled map colors and Romanian diacritics.",
      "Do show administrative scope, source year and license beside imported outlines."
    ],
    "donts": [
      "Don't add a decorative glow behind the workspace.",
      "Don't replace the geographic status palette with brand yellow.",
      "Don't turn source records into rounded floating cards.",
      "Don't animate controls when reduced motion is requested.",
      "Don't present administrative reference areas as Roma settlement boundaries."
    ]
  }
}
