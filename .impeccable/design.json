      "css": ".ds-status{font-family:var(--font-host-grotesk),sans-serif;display:inline-flex;font-size:10px;padding:2px 6px;border-radius:4px;background:#e3f3ea;color:#256144;font-weight:450;}"
    },
    {
      "name": "Source Section",
      "kind": "card",
      "refersTo": "card",
      "description": "Flat source content separated by a quiet divider.",
      "html": "<section class=\"ds-card\"><b>Sursa datelor</b><p>Verifică sursa și aria administrativă.</p><a href=\"#source\">Vezi sursa</a></section>",
      "css": ".ds-card{font-family:var(--font-host-grotesk),sans-serif;padding:0 0 22px;border-bottom:1px solid var(--border,#e5e9ed);color:var(--text,#202b33);}.ds-card b{font-size:13px;font-weight:600;}.ds-card p{margin-top:12px;line-height:1.75;font-size:13px;}.ds-card a{color:var(--primary,#107c70);font-size:12px;text-underline-offset:3px;}.ds-card a:hover{text-decoration-thickness:2px;}.ds-card a:focus-visible{outline:2px solid var(--primary,#107c70);outline-offset:3px;}"
    },
    {
      "name": "Map Legend",
      "kind": "custom",
      "description": "Floating, initially collapsed map key.",
      "html": "<details class=\"ds-key\"><summary>Legendă</summary><div><i></i>Comunitate validată</div></details>",
      "css": ".ds-key{font-family:var(--font-host-grotesk),sans-serif;background:var(--panel,#fff);color:var(--text,#202b33);border-radius:8px;box-shadow:var(--floating-shadow,0 4px 18px #24374714);font-size:11px;}.ds-key summary{padding:10px 13px;cursor:pointer;}.ds-key summary:hover{background:var(--hover,#f1f5f6);border-radius:8px;}.ds-key summary:focus-visible{outline:2px solid var(--primary,#107c70);outline-offset:3px;}.ds-key div{display:flex;gap:6px;align-items:center;padding:4px 13px 14px;}.ds-key i{width:8px;height:8px;border-radius:50%;background:#206457;}"
    },
    {
      "name": "Map Dataset Subfilters",
      "kind": "custom",
      "description": "Dataset choices live inside Map, below module navigation.",
      "html": "<div class=\"ds-datasets\" aria-label=\"Set de date\"><button class=\"ds-selected\">Comunități</button><button>Antreprenori</button><button>Parteneri</button><button>Suprapunere</button></div>",
      "css": ".ds-datasets{display:flex;gap:4px;flex-wrap:wrap;padding-bottom:12px;border-bottom:1px solid var(--border,#e5e9ed);font-family:var(--font-host-grotesk),sans-serif}.ds-datasets button{font-family:inherit;min-height:28px;padding:5px 7px;font-size:10px;border:1px solid transparent;border-radius:8px;background:transparent;color:var(--text,#202b33);cursor:pointer}.ds-datasets button.ds-selected{background:var(--selected,#eaf5f1);color:var(--primary,#107c70)}.ds-datasets button:hover{background:var(--hover,#f1f5f6)}.ds-datasets button:focus-visible{outline:2px solid var(--primary,#107c70);outline-offset:3px}"
    },
    {
      "name": "Territorial Metric Strip",
      "kind": "custom",
      "description": "Baseline accessible-data totals; em dashes represent loading, never invented counts.",
      "html": "<dl class=\"ds-metrics\"><div><dt>Comunități vizibile</dt><dd>—</dd></div><div><dt>Zone distincte</dt><dd>—</dd></div><div><dt>De verificat</dt><dd>—</dd></div><div><dt>Fără geometrie</dt><dd>—</dd></div></dl>",
      "css": ".ds-metrics{font-family:var(--font-host-grotesk),sans-serif;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px;margin:0 0 32px;padding-bottom:28px;border-bottom:1px solid var(--border,#e5e9ed);font-variant-numeric:tabular-nums;color:var(--text,#202b33)}.ds-metrics dt{font-size:12px;color:var(--muted,#64717d);margin-bottom:8px}.ds-metrics dd{margin:0;font-size:32px;font-weight:550;letter-spacing:-.03em;line-height:1.3}@media(max-width:760px){.ds-metrics{grid-template-columns:repeat(2,minmax(0,1fr));gap:24px 12px}.ds-metrics dd{font-size:28px}}"
    }
  ],
  "narrative": {
    "northStar": "The Focused GIS Workspace",
    "overview": "White task surfaces, cool gray navigation and restrained teal actions form a compact GIS workspace inspired by Linear. Host Grotesk carries headings, controls, source prose and data in one clear sans-serif voice. The map remains the main working surface, with a light Esri basemap by default.\n\nThe interface owns the viewport: persistent navigation, a quiet header and independently scrolling tools frame the map or report. Thin dividers and gently rounded controls establish hierarchy; established dataset colors retain their geographic meaning.",
    "keyCharacteristics": [
      "White panels and cool gray navigation with restrained teal emphasis.",
      "One compact Host Grotesk typographic system.",
      "Gently rounded controls and a dominant light working map.",
      "Labeled dataset colors, scope dashes and visible source provenance."
    ],
    "rules": [
      {
        "name": "The Geographic Continuity Rule",
        "body": "Preserve semantic map colors independently of interface action colors.",
        "section": "colors"
      },
      {
        "name": "The Working Surface Rule",
        "body": "Separate ordinary records with borders and tonal changes; reserve shadows for floating map instruments, drawers and dialogs.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use Host Grotesk for headings, controls, data and source prose.",
      "Do pair teal primary actions with white labels and retain visible keyboard focus.",
      "Do preserve labeled map colors, Romanian diacritics and tabular numeric columns.",
      "Do show administrative scope, source year and license beside imported outlines.",
      "Do keep task panels, reports and wide tables scrolling inside the viewport."
    ],
    "donts": [
      "Don't restore the superseded forest/yellow identity or serif reading typography.",
      "Don't replace dataset colors with the interface accent.",
      "Don't add a landing introduction, footer or decorative glow to the working shell.",
      "Don't animate controls when reduced motion is requested.",
      "Don't present administrative reference areas as Roma settlement boundaries."
    ]
  }
}
